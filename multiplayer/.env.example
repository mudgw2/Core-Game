# CORE Colyseus service configuration (do not commit real secrets).
NODE_ENV=development
CORE_MULTIPLAYER_HOST=127.0.0.1
CORE_MULTIPLAYER_PORT=2567
CORE_MULTIPLAYER_ROOM_CAPACITY=16
CORE_MULTIPLAYER_ALLOW_DEV_GUESTS=false
CORE_MULTIPLAYER_DEV_TOKEN=
# Development guests are accepted only outside production, on loopback, and
# with a token of at least 32 characters. PHP-issued grants are implemented
# in 0.1.111; do not expose this development mode publicly.
