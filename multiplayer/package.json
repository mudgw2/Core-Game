{
  "name": "core-multiplayer",
  "version": "0.1.115",
  "private": true,
  "description": "CORE Game 1.0 real-time multiplayer service foundation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "postinstall": "node scripts/patch-colyseus-nanoid.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/ws-transport": "^0.16.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "main": "dist/server.js",
  "overrides": {
    "@colyseus/core": {
      "nanoid": "^3.3.18"
    }
  }
}
